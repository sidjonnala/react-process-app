# Server Configuration
PORT=3000
NODE_ENV=development

# Security - Optional webhook validation token
# If set, the API will require x-webhook-token header to match this value
WEBHOOK_SECRET=your-secret-token-here

# Azure DevOps Configuration
# Optional: If set, the API will fetch old iteration path from ADO API when not in webhook
# Get a PAT from: https://dev.azure.com/{org}/_usersSettings/tokens
# Required scopes: Work Items (Read & Write)
ADO_PAT=your-azure-devops-pat-here

# Board Management
# Email or name of the board manager to contact when iteration changes are blocked
BOARD_MANAGER_EMAIL=boardmanager@company.com

# Board Managers - Comma-separated list of email addresses or unique names who can bypass iteration validation
# These users can add work items to started iterations without being blocked
BOARD_MANAGERS=boardmanager@company.com,scrum.master@company.com
